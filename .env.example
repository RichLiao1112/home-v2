# 鐧诲綍璁よ瘉
LOGIN_PASSWORD=admin123
AUTH_SECRET=change-me-to-a-long-random-string

# Unsplash API锛堝彲閫夛紝鐢ㄤ簬鍥剧墖鎼滅储锛?
# 娉ㄥ唽鍦板潃锛歨ttps://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Docker build mode: set false on Windows hosts that block symlink creation
NEXT_OUTPUT_STANDALONE=true

# MCP 鏈嶅姟璁よ瘉锛堝彲閫夛紝鐢ㄤ簬澶栭儴API璋冪敤锛?
MCP_API_KEY=
